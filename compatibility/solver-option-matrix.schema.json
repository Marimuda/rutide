{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rutide.invalid/schemas/solver-option-matrix-v1.json",
  "title": "RUTide solver-option compatibility matrix",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "matrix_schema_version",
    "last_reviewed",
    "python_oracle_revision",
    "composition",
    "axes",
    "rejection_constraints",
    "parity_exceptions",
    "coverage"
  ],
  "properties": {
    "$schema": { "type": "string" },
    "matrix_schema_version": { "type": "integer", "const": 1 },
    "last_reviewed": { "type": "string", "format": "date" },
    "python_oracle_revision": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "composition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["default_status", "statement"],
      "properties": {
        "default_status": { "const": "supported" },
        "statement": { "type": "string", "minLength": 1 }
      }
    },
    "axes": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scope",
        "sampling",
        "constituent_selection",
        "inference",
        "analysis_method",
        "robust_weight",
        "trend",
        "phase_reference",
        "nodal_corrections",
        "prefilter",
        "confidence_method",
        "confidence_noise",
        "constituent_diagnostics",
        "constituent_order",
        "reconstruction"
      ],
      "properties": {
        "scope": { "$ref": "#/$defs/nonEmptyUniqueStrings" },
        "sampling": { "$ref": "#/$defs/nonEmptyUniqueStrings" },
        "constituent_selection": { "$ref": "#/$defs/nonEmptyUniqueStrings" },
        "inference": { "$ref": "#/$defs/nonEmptyUniqueStrings" },
        "analysis_method": { "$ref": "#/$defs/nonEmptyUniqueStrings" },
        "robust_weight": { "$ref": "#/$defs/nonEmptyUniqueStrings" },
        "trend": { "$ref": "#/$defs/nonEmptyUniqueStrings" },
        "phase_reference": { "$ref": "#/$defs/nonEmptyUniqueStrings" },
        "nodal_corrections": { "$ref": "#/$defs/nonEmptyUniqueStrings" },
        "prefilter": { "$ref": "#/$defs/nonEmptyUniqueStrings" },
        "confidence_method": { "$ref": "#/$defs/nonEmptyUniqueStrings" },
        "confidence_noise": { "$ref": "#/$defs/nonEmptyUniqueStrings" },
        "constituent_diagnostics": { "$ref": "#/$defs/nonEmptyUniqueStrings" },
        "constituent_order": { "$ref": "#/$defs/nonEmptyUniqueStrings" },
        "reconstruction": { "$ref": "#/$defs/nonEmptyUniqueStrings" }
      }
    },
    "rejection_constraints": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/rejectionConstraint" }
    },
    "parity_exceptions": {
      "type": "array",
      "items": { "$ref": "#/$defs/parityException" }
    },
    "coverage": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/coverageEntry" }
    }
  },
  "$defs": {
    "nonEmptyUniqueStrings": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "rejectionConstraint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "status", "rule", "reason", "evidence"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
        "status": { "const": "rejected" },
        "rule": { "type": "string", "minLength": 1 },
        "reason": { "type": "string", "minLength": 1 },
        "evidence": { "$ref": "#/$defs/evidence" }
      }
    },
    "parityException": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "parity", "condition", "reason", "evidence"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
        "parity": { "const": "rust-extension" },
        "condition": { "type": "string", "minLength": 1 },
        "reason": { "type": "string", "minLength": 1 },
        "evidence": { "$ref": "#/$defs/evidence" }
      }
    },
    "coverageEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "covers", "evidence"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
        "kind": {
          "enum": [
            "python-oracle",
            "composition-invariant",
            "application-integration",
            "python-oracle-and-extension-invariants",
            "python-input-oracle-and-extension-invariants",
            "python-oracle-and-application-integration"
          ]
        },
        "covers": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": { "$ref": "#/$defs/nonEmptyUniqueStrings" }
        },
        "evidence": { "$ref": "#/$defs/evidence" }
      }
    }
  }
}
