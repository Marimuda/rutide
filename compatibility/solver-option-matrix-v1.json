{
  "$schema": "./solver-option-matrix.schema.json",
  "matrix_schema_version": 1,
  "last_reviewed": "2026-09-03",
  "python_oracle_revision": "8fabe121752bc317931472a10a42e306715106de",
  "composition": {
    "default_status": "supported",
    "statement": "Every Cartesian product of the listed axis values is supported for scalar and vector analysis when the rejection constraints are satisfied. Parity exceptions identify scientifically supported Rust extensions rather than unsupported combinations."
  },
  "axes": {
    "scope": ["scalar", "vector"],
    "sampling": ["regular", "gappy-regular-grid", "irregular"],
    "constituent_selection": ["explicit", "rayleigh"],
    "inference": ["none", "exact", "approximate"],
    "analysis_method": ["ols", "robust"],
    "robust_weight": [
      "not-applicable",
      "andrews",
      "bisquare",
      "cauchy",
      "fair",
      "huber",
      "logistic",
      "ols",
      "talwar",
      "welsch"
    ],
    "trend": ["enabled", "disabled"],
    "phase_reference": ["greenwich", "linear-time", "raw"],
    "nodal_corrections": ["exact", "linear-time", "disabled"],
    "prefilter": ["none", "real"],
    "confidence_method": ["none", "linear", "monte-carlo"],
    "confidence_noise": ["not-applicable", "white", "colored"],
    "constituent_diagnostics": ["disabled", "enabled"],
    "constituent_order": [
      "selection",
      "frequency",
      "percent-energy",
      "signal-to-noise",
      "explicit-permutation"
    ],
    "reconstruction": [
      "none",
      "all",
      "constituents",
      "diagnostics-percent-energy",
      "diagnostics-percent-energy-and-snr"
    ]
  },
  "rejection_constraints": [
    {
      "id": "prefilter-response-is-valid",
      "status": "rejected",
      "rule": "prefilter=real requires a finite increasing frequency grid, finite real gains, and an explicit positive acceptable magnitude range",
      "reason": "Unknown, complex, out-of-grid, or near-zero responses cannot be silently converted into stable physical coefficients.",
      "evidence": ["crates/rutide-core/src/prefilter.rs", "PREFILTER_TRANSFER.md"]
    },
    {
      "id": "ols-has-no-robust-weight",
      "status": "rejected",
      "rule": "analysis_method=ols requires robust_weight=not-applicable",
      "reason": "Robust options supplied to an OLS analysis are ambiguous and rejected instead of ignored.",
      "evidence": ["crates/rutide-cli/src/main.rs"]
    },
    {
      "id": "robust-requires-weight",
      "status": "rejected",
      "rule": "analysis_method=robust requires robust_weight!=not-applicable",
      "reason": "Every IRLS solve has an explicit residual-weight definition; Cauchy is the default.",
      "evidence": ["crates/rutide-cli/src/main.rs"]
    },
    {
      "id": "confidence-none-has-no-noise-model",
      "status": "rejected",
      "rule": "confidence_method=none requires confidence_noise=not-applicable",
      "reason": "A residual-noise model has no meaning without confidence estimation.",
      "evidence": ["crates/rutide-cli/src/main.rs"]
    },
    {
      "id": "confidence-requires-noise-model",
      "status": "rejected",
      "rule": "confidence_method!=none requires confidence_noise in {white,colored}",
      "reason": "Linear and Monte Carlo covariance construction require a declared residual-noise model.",
      "evidence": ["crates/rutide-cli/src/lib.rs"]
    },
    {
      "id": "snr-order-requires-confidence",
      "status": "rejected",
      "rule": "constituent_order=signal-to-noise requires confidence_method!=none",
      "reason": "Signal-to-noise ratios are derived from confidence intervals.",
      "evidence": ["crates/rutide-cli/src/lib.rs", "crates/rutide-cli/src/main.rs"]
    },
    {
      "id": "constituent-diagnostics-require-confidence",
      "status": "rejected",
      "rule": "constituent_diagnostics=enabled requires confidence_method!=none",
      "reason": "RNM, significant-subset tidal variance, and whole-model SNR require constituent signal-to-noise ratios.",
      "evidence": ["crates/rutide-cli/src/lib.rs", "crates/rutide-cli/src/main.rs"]
    },
    {
      "id": "snr-reconstruction-requires-confidence",
      "status": "rejected",
      "rule": "reconstruction=diagnostics-percent-energy-and-snr requires confidence_method!=none",
      "reason": "Signal-to-noise reconstruction filtering requires computed confidence intervals.",
      "evidence": ["crates/rutide-core/src/corrected.rs", "crates/rutide-cli/src/main.rs"]
    },
    {
      "id": "inference-requires-valid-relationships",
      "status": "rejected",
      "rule": "inference!=none requires one or more valid acyclic inferred/reference relationships",
      "reason": "Empty, self-referential, duplicate, non-finite, or inferred-reference graphs are rejected.",
      "evidence": ["crates/rutide-core/tests/python_oracle_inference.rs"]
    },
    {
      "id": "explicit-order-is-complete",
      "status": "rejected",
      "rule": "constituent_order=explicit-permutation requires each fitted constituent exactly once",
      "reason": "Presentation order cannot add, omit, or duplicate fitted coefficients.",
      "evidence": ["crates/rutide-cli/src/lib.rs", "crates/rutide-cli/src/main.rs"]
    },
    {
      "id": "explicit-reconstruction-is-selected-subset",
      "status": "rejected",
      "rule": "reconstruction=constituents requires a non-empty unique subset of fitted constituents",
      "reason": "Reconstruction cannot reference an unavailable coefficient.",
      "evidence": ["crates/rutide-core/src/corrected.rs", "crates/rutide-cli/src/main.rs"]
    },
    {
      "id": "monte-carlo-requires-replicates",
      "status": "rejected",
      "rule": "confidence_method=monte-carlo requires realizations>=2",
      "reason": "At least two realizations are needed to estimate a distribution interval.",
      "evidence": ["crates/rutide-core/src/monte_carlo.rs", "crates/rutide-cli/src/main.rs"]
    },
    {
      "id": "retained-time-axis-is-strict",
      "status": "rejected",
      "rule": "normalized retained timestamps must be finite and strictly increasing",
      "reason": "Non-finite source timestamps are removed with their observations; duplicate or decreasing retained timestamps are ambiguous.",
      "evidence": ["crates/rutide-core/src/time.rs"]
    },
    {
      "id": "model-is-overdetermined",
      "status": "rejected",
      "rule": "each retained series must contain more finite observations than fitted model columns",
      "reason": "Underdetermined harmonic fits do not have a unique least-squares solution.",
      "evidence": ["crates/rutide-core/src/scalar.rs"]
    }
  ],
  "parity_exceptions": [
    {
      "id": "monte-carlo-inference",
      "parity": "rust-extension",
      "condition": "inference!=none and confidence_method=monte-carlo",
      "reason": "Python UTide rejects Monte Carlo confidence with inference; RUTide propagates shared reference draws through every relationship.",
      "evidence": [
        "crates/rutide-core/tests/python_oracle_inference.rs",
        "benchmarks/results/inferred-monte-carlo-2026-09-02.md"
      ]
    },
    {
      "id": "broken-python-robust-array-weights",
      "parity": "rust-extension",
      "condition": "robust_weight in {andrews,huber,logistic}",
      "reason": "The pinned Python implementations raise on residual arrays; RUTide uses the standard bounded scalar definitions.",
      "evidence": [
        "crates/rutide-core/tests/python_oracle_greenwich_nodal.rs"
      ]
    },
    {
      "id": "effective-monte-carlo-realization-count",
      "parity": "rust-extension",
      "condition": "confidence_method=monte-carlo and configured realizations!=200",
      "reason": "Python UTide ignores MC_n and always draws 200 realizations; RUTide makes the validated setting effective.",
      "evidence": [
        "crates/rutide-core/tests/python_oracle_greenwich_nodal.rs"
      ]
    }
  ],
