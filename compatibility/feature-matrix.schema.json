{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rutide.invalid/schemas/feature-matrix-v1.json",
  "title": "RUTide compatibility feature matrix",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "matrix_schema_version",
    "project_version",
    "last_reviewed",
    "python_oracle",
    "contracts",
    "features"
  ],
  "properties": {
    "$schema": { "type": "string" },
    "matrix_schema_version": { "type": "integer", "const": 1 },
    "project_version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "last_reviewed": { "type": "string", "format": "date" },
    "python_oracle": {
      "type": "object",
      "additionalProperties": false,
      "required": ["implementation", "revision"],
      "properties": {
        "implementation": { "type": "string", "const": "UTide" },
        "revision": { "type": "string", "pattern": "^[0-9a-f]{40}$" }
      }
    },
    "contracts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rust_api", "python_api", "netcdf", "json_report", "result_digest"],
      "properties": {
        "rust_api": {
          "type": "object",
          "additionalProperties": false,
          "required": ["stability", "rust_version"],
          "properties": {
            "stability": { "enum": ["pre-1.0"] },
            "rust_version": { "type": "string" }
          }
        },
        "python_api": {
          "type": "object",
          "additionalProperties": false,
          "required": ["stability", "minimum_python", "abi", "coefficient_schema"],
          "properties": {
            "stability": { "enum": ["pre-1.0"] },
            "minimum_python": { "type": "string" },
            "abi": { "type": "string" },
            "coefficient_schema": { "type": "integer", "minimum": 1 }
          }
        },
        "netcdf": {
          "type": "object",
          "additionalProperties": false,
          "required": ["scalar_schema_version", "vector_schema_version"],
          "properties": {
            "scalar_schema_version": { "type": "integer", "minimum": 1 },
            "vector_schema_version": { "type": "integer", "minimum": 1 }
          }
        },
        "json_report": {
          "type": "object",
          "additionalProperties": false,
          "required": ["version_source"],
          "properties": { "version_source": { "enum": ["matching-netcdf-schema"] } }
        },
        "result_digest": {
          "type": "object",
          "additionalProperties": false,
          "required": ["stability"],
          "properties": { "stability": { "enum": ["schema-and-profile"] } }
        }
      }
    },
    "features": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "title", "support", "scopes", "parity", "evidence"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
          "title": { "type": "string", "minLength": 1 },
          "support": { "enum": ["supported", "planned", "not-planned"] },
          "scopes": {
            "type": "array",
            "minItems": 1,
            "items": {
              "enum": ["core", "fvcom-scalar", "fvcom-vector", "python-api", "output"]
            }
          },
          "parity": { "enum": ["python-oracle", "matlab-restoration", "rust-extension", "not-applicable"] },
          "evidence": { "type": "array", "items": { "type": "string" } },
          "limitations": { "type": "array", "items": { "type": "string" } }
        }
      }
    }
  }
}
